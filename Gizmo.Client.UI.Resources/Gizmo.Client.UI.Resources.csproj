<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<!--<RootNamespace>Gizmo.Client.UI</RootNamespace>-->
		<PackageId>Gizmo.Client.UI.Resources</PackageId>
		<Version>1.0</Version>
		<Authors>Oleg Savelos</Authors>
		<Description>Localization resources for the Gizmo client UI.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/GAMP/Gizmo.Client.UI.Resources</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Remove="Properties\Resources.resx" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Properties\Resources.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <CustomToolNamespace></CustomToolNamespace>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>
	
</Project>
